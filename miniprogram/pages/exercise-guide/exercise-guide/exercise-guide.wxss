.page {
  padding: 20rpx 28rpx;
}

/* 搜索框 */
.search-bar {
  margin-bottom: 24rpx;
}

.search-input {
  background: var(--bg-card);
  border: 1rpx solid var(--border);
  border-radius: var(--radius-sm);
  padding: 18rpx 24rpx;
  font-size: 28rpx;
  color: var(--text-primary);
}

/* 搜索结果 */
.search-results {
  background: var(--bg-card);
  border: 1rpx solid var(--border);
  border-radius: var(--radius-sm);
  overflow: hidden;
  margin-bottom: 24rpx;
}

.search-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 24rpx;
  border-bottom: 1rpx solid var(--border-light);
}

.search-item:last-child {
  border-bottom: none;
}

.search-name {
  font-size: 28rpx;
  color: var(--text-primary);
  font-weight: 500;
}

.search-group-tag {
  font-size: 20rpx;
  color: var(--text-hint);
  background: var(--bg-card);
  border: 1rpx solid var(--border);
  padding: 4rpx 12rpx;
  border-radius: var(--radius-sm);
}

/* 肌群卡片 */
.group-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.group-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: var(--bg-card);
  border: 1rpx solid var(--border);
  border-radius: var(--radius-md);
  padding: 28rpx 24rpx;
}

.group-info {
  flex: 1;
  min-width: 0;
}

.group-name {
  font-size: 34rpx;
  font-weight: 600;
  color: var(--text-primary);
  display: block;
}

.group-count {
  font-size: 24rpx;
  color: var(--text-hint);
  margin-top: 4rpx;
  display: block;
}

.group-arrow {
  font-size: 28rpx;
  color: var(--text-muted);
  flex-shrink: 0;
  margin-left: 12rpx;
}
