.page {
  padding: 0 28rpx 40rpx;
}

/* 登录提示卡片 */
.login-card {
  margin: 0 28rpx 24rpx;
  padding: 36rpx;
  background: var(--bg-card);
  border: 1rpx solid var(--border);
  border-radius: var(--radius-md);
  text-align: center;
}

.login-card-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text-primary);
  display: block;
  margin-bottom: 12rpx;
}

.login-card-desc {
  font-size: 24rpx;
  color: var(--text-hint);
  display: block;
  margin-bottom: 28rpx;
}

.login-card-btn {
  display: inline-block;
  background: var(--text-primary);
  color: #fff;
  padding: 18rpx 64rpx;
  border-radius: var(--radius-sm);
}

.login-card-btn-text {
  font-size: 28rpx;
  font-weight: 600;
}

/* 顶部 */
.hero {
  padding: 48rpx 28rpx 28rpx;
}

.hero-greeting {
  font-size: 44rpx;
  font-weight: 800;
  color: var(--text-primary);
  display: block;
  letter-spacing: -1rpx;
}

.hero-date {
  font-size: 22rpx;
  color: var(--text-hint);
  margin-top: 4rpx;
  display: block;
  letter-spacing: 2rpx;
}

/* 卡路里卡片 */
.calorie-card {
  margin: 0 28rpx 24rpx;
  background: var(--bg-card);
  border: 1rpx solid var(--border);
  border-radius: var(--radius-md);
  padding: 28rpx 32rpx;
}

.cal-top {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.cal-top-label {
  font-size: 22rpx;
  color: var(--text-hint);
  letter-spacing: 1rpx;
}

.cal-top-val {
  font-size: 40rpx;
  font-weight: 200;
  color: var(--text-primary);
  font-variant-numeric: tabular-nums;
}

.cal-top-unit {
  font-size: 22rpx;
  color: var(--text-hint);
  font-weight: 400;
}

.cal-bar-wrap {
  margin-bottom: 20rpx;
}

.cal-bar-bg {
  height: 14rpx;
  background: var(--border-light);
  border-radius: 7rpx;
  overflow: hidden;
}

.cal-bar-fill {
  height: 100%;
  background: var(--accent);
  border-radius: 7rpx;
  transition: width 0.5s ease;
}

.cal-bar-over {
  background: var(--danger);
}

.cal-bar-target {
  text-align: right;
  margin-top: 6rpx;
}

.cal-bar-target-text {
  font-size: 20rpx;
  color: var(--text-hint);
}

.cal-bottom {
  display: flex;
  align-items: center;
  padding-top: 16rpx;
  border-top: 1rpx solid var(--border-light);
}

.cal-bottom-item {
  flex: 1;
  text-align: center;
}

.cal-bottom-num {
  font-size: 30rpx;
  font-weight: 200;
  color: var(--text-primary);
  display: block;
  font-variant-numeric: tabular-nums;
}

.cal-bottom-num.deficit {
  color: var(--accent);
}

.cal-bottom-num.surplus {
  color: var(--danger);
}

.cal-bottom-label {
  font-size: 20rpx;
  color: var(--text-hint);
  margin-top: 4rpx;
  display: block;
  letter-spacing: 1rpx;
}

.cal-bottom-divider {
  width: 1rpx;
  height: 48rpx;
  background: var(--border);
}

/* 快捷入口 */
.shortcuts {
  display: flex;
  gap: 12rpx;
  padding: 0 28rpx;
  margin-bottom: 32rpx;
}

.shortcut {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 24rpx 0;
  background: var(--bg-card);
  border: 1rpx solid var(--border);
  border-radius: var(--radius-sm);
}

.shortcut-icon {
  font-size: 32rpx;
  color: var(--text-secondary);
  font-weight: 200;
  margin-bottom: 8rpx;
}

.shortcut-text {
  font-size: 22rpx;
  color: var(--text-hint);
  letter-spacing: 1rpx;
}

/* 分区标题 */
.section-head {
  padding: 0 28rpx 12rpx;
}

.section-title {
  font-size: 20rpx;
  color: var(--text-hint);
  letter-spacing: 3rpx;
  font-weight: 600;
  text-transform: uppercase;
}

/* 记录列表 */
.record-group-label {
  font-size: 20rpx;
  color: var(--text-hint);
  letter-spacing: 2rpx;
  display: block;
  margin-bottom: 14rpx;
}

.record-item {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid var(--border-light);
}

.record-item:last-child {
  border-bottom: none;
  padding-bottom: 0;
}

.record-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 2rpx;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.dot-food {
  background: var(--accent);
}

.dot-exercise {
  background: rgba(168,181,160,0.5);
}

.record-info {
  flex: 1;
}

.record-name {
  font-size: 28rpx;
  color: var(--text-primary);
  display: block;
}

.record-meta {
  font-size: 20rpx;
  color: var(--text-hint);
  margin-top: 2rpx;
  display: block;
}

.record-val {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-primary);
  flex-shrink: 0;
  font-variant-numeric: tabular-nums;
}

.record-estimating {
  font-size: 22rpx;
  font-weight: 400;
  color: var(--text-hint);
}

/* 反馈入口 */
.feedback-entry {
  text-align: center;
  padding: 32rpx 0 16rpx;
}

.feedback-text {
  font-size: 40rpx;
  color: var(--text-hint);
  letter-spacing: 1rpx;
  text-decoration: underline;
}

/* 空状态 */
.empty {
  text-align: center;
  padding: 80rpx 40rpx;
}

.empty-main {
  font-size: 28rpx;
  color: var(--text-secondary);
  display: block;
}

.empty-sub {
  font-size: 22rpx;
  color: var(--text-hint);
  margin-top: 8rpx;
  display: block;
}

/* 左滑删除 */
.record-item-wrap {
  position: relative;
  overflow: hidden;
}

.record-item-swipe {
  transition: transform 0.2s;
}

.record-item-swiped {
  transform: translateX(-140rpx);
}

.record-delete-btn {
  position: absolute;
  right: 0;
  top: 0;
  bottom: 0;
  width: 140rpx;
  background: #c47a6c;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 0 var(--radius-md) var(--radius-md) 0;
}

.record-delete-text {
  font-size: 26rpx;
  color: #fff;
  font-weight: 600;
}

/* 编辑弹窗 */
.edit-mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.4);
  z-index: 1000;
  opacity: 0;
  visibility: hidden;
  transition: all 0.25s;
}

.edit-mask-show {
  opacity: 1;
  visibility: visible;
}

.edit-sheet {
  position: fixed;
  left: 0; right: 0; bottom: 0;
  background: var(--bg-card);
  border-radius: 24rpx 24rpx 0 0;
  padding: 40rpx 32rpx;
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
  transform: translateY(100%);
  transition: transform 0.3s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  z-index: 1001;
  max-height: 80vh;
  overflow-y: auto;
}

.edit-sheet-show {
  transform: translateY(0);
}

.edit-field {
  margin-bottom: 24rpx;
}

.edit-label {
  font-size: 22rpx;
  color: var(--text-hint);
  margin-bottom: 10rpx;
  display: block;
}

.edit-input {
  background: var(--bg-input);
  border: 1rpx solid var(--border);
  border-radius: var(--radius-sm);
  padding: 18rpx 22rpx;
  font-size: 28rpx;
  color: var(--text-primary);
}

.edit-row {
  display: flex;
  gap: 16rpx;
}

.edit-field-half {
  flex: 1;
}

/* 步进器（复用 log 页样式） */
.qty-stepper {
  display: flex;
  align-items: center;
  background: var(--bg-input);
  border: 1rpx solid var(--border);
  border-radius: var(--radius-sm);
  overflow: hidden;
}

.stepper-btn {
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.stepper-icon {
  font-size: 32rpx;
  color: var(--text-secondary);
  font-weight: 600;
}

.qty-input {
  flex: 1;
  text-align: center;
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-primary);
  height: 72rpx;
  background: transparent;
  border: none;
}

/* 餐次选择（复用 log 页样式） */
.meal-types {
  display: flex;
  gap: 12rpx;
}

.meal-btn {
  flex: 1;
  text-align: center;
  padding: 14rpx 0;
  font-size: 24rpx;
  color: var(--text-hint);
  background: var(--bg-card);
  border: 1rpx solid var(--border);
  border-radius: var(--radius-sm);
}

.meal-active {
  color: var(--accent);
  border-color: var(--accent);
  background: var(--accent-dim);
}

/* 弹窗操作按钮 */
.edit-actions {
  margin-top: 32rpx;
}

.edit-save-btn {
  background: var(--text-primary);
  border-radius: var(--radius-sm);
  padding: 22rpx;
  text-align: center;
}

.edit-save-text {
  font-size: 28rpx;
  font-weight: 700;
  color: #fff;
  letter-spacing: 2rpx;
}

.edit-delete-link {
  text-align: center;
  padding: 24rpx 0 0;
}

.edit-delete-link-text {
  font-size: 24rpx;
  color: var(--danger);
}
