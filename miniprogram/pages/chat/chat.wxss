.page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: var(--bg-base);
  overflow: hidden;
  width: 100%;
  box-sizing: border-box;
}

/* 快捷入口 */
.shortcuts-bar {
  white-space: nowrap;
  padding: 16rpx 28rpx;
  border-bottom: 1rpx solid var(--border);
  flex-shrink: 0;
}

.chip {
  display: inline-flex;
  align-items: center;
  padding: 10rpx 22rpx;
  margin-right: 12rpx;
  background: var(--bg-card);
  border: 1rpx solid var(--border);
  border-radius: var(--radius-sm);
}

.chip-text {
  font-size: 22rpx;
  color: var(--text-secondary);
  letter-spacing: 1rpx;
}

/* 消息列表 */
.msg-list {
  flex: 1;
  padding: 24rpx 28rpx;
  overflow-x: hidden;
  width: 100%;
  box-sizing: border-box;
}

.msg-item {
  display: flex;
  margin-bottom: 24rpx;
  align-items: flex-start;
}

.msg-item.user {
  flex-direction: row-reverse;
}

/* 消息体（气泡+时间） */
.msg-body {
  display: flex;
  flex-direction: column;
  max-width: calc(100% - 80rpx);
}

.msg-item.user .msg-body {
  align-items: flex-end;
}

/* AI 头像 */
.msg-avatar {
  width: 48rpx;
  height: 48rpx;
  border-radius: var(--radius-sm);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 18rpx;
  font-weight: 700;
  flex-shrink: 0;
  margin-right: 14rpx;
  background: var(--accent-dim);
  color: var(--accent);
  letter-spacing: 1rpx;
}

.msg-item.user .msg-avatar {
  margin-right: 0;
  margin-left: 14rpx;
}

.msg-avatar-img {
  width: 48rpx;
  height: 48rpx;
  border-radius: var(--radius-sm);
  flex-shrink: 0;
  margin-left: 14rpx;
}

/* 气泡 */
.msg-bubble {
  padding: 20rpx 24rpx;
  border-radius: var(--radius-md);
  word-break: break-all;
  overflow-wrap: break-word;
}

.bubble-user {
  background: var(--accent-dim);
  color: var(--text-primary);
}

.bubble-ai {
  background: var(--bg-card);
  border: 1rpx solid var(--border);
  color: var(--text-primary);
}

.msg-text {
  font-size: 24rpx;
  line-height: 1.7;
}

/* 消息时间 */
.msg-time {
  font-size: 20rpx;
  color: var(--text-hint);
  margin-top: 6rpx;
  text-align: right;
  display: block;
}

/* mp-html markdown 样式 */
.bubble-ai rich-text {
  font-size: 22rpx;
  line-height: 1.8;
  color: #333;
}

.bubble-ai rich-text h1,
.bubble-ai rich-text h2,
.bubble-ai rich-text h3 {
  font-weight: 700;
  color: var(--text-primary);
  margin: 24rpx 0 12rpx;
  line-height: 1.4;
}

.bubble-ai rich-text h1 { font-size: 34rpx; }
.bubble-ai rich-text h2 { font-size: 30rpx; }
.bubble-ai rich-text h3 { font-size: 28rpx; }

.bubble-ai rich-text p {
  margin: 12rpx 0;
}

.bubble-ai rich-text ul,
.bubble-ai rich-text ol {
  padding-left: 32rpx;
  margin: 12rpx 0;
}

.bubble-ai rich-text li {
  margin: 8rpx 0;
}

.bubble-ai rich-text code {
  font-family: monospace;
  font-size: 24rpx;
  background: rgba(0, 0, 0, 0.06);
  padding: 2rpx 8rpx;
  border-radius: 4rpx;
}

.bubble-ai rich-text pre {
  background: rgba(0, 0, 0, 0.06);
  padding: 16rpx;
  border-radius: 8rpx;
  overflow-x: auto;
  margin: 12rpx 0;
}

.bubble-ai rich-text pre code {
  background: none;
  padding: 0;
}

.bubble-ai rich-text blockquote {
  border-left: 6rpx solid var(--accent);
  padding-left: 16rpx;
  margin: 12rpx 0;
  color: var(--text-secondary);
}

.bubble-ai rich-text table {
  border-collapse: collapse;
  margin: 16rpx 0;
  width: 100%;
}

.bubble-ai rich-text th,
.bubble-ai rich-text td {
  border: 1rpx solid var(--border);
  padding: 10rpx 14rpx;
  text-align: left;
  font-size: 24rpx;
}

.bubble-ai rich-text th {
  background: rgba(0, 0, 0, 0.04);
  font-weight: 600;
}

.bubble-ai rich-text strong {
  font-weight: 700;
}

.bubble-ai rich-text em {
  font-style: italic;
}

/* 加载动画 */
.msg-loading {
  display: flex;
  gap: 8rpx;
  padding-top: 8rpx;
}

.loading-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 2rpx;
  background: var(--text-hint);
  animation: dotPulse 1.4s infinite ease-in-out;
}

.loading-dot:nth-child(2) {
  animation-delay: 0.2s;
}

.loading-dot:nth-child(3) {
  animation-delay: 0.4s;
}

@keyframes dotPulse {
  0%, 80%, 100% { opacity: 0.2; }
  40% { opacity: 1; }
}

/* 意图记录按钮 */
.intent-bar {
  display: flex;
  align-items: center;
  padding: 12rpx 28rpx;
  border-top: 1rpx solid var(--border);
  flex-shrink: 0;
  background: var(--bg-card);
}

.intent-btn {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 18rpx 24rpx;
  background: var(--accent-dim);
  border: 1rpx solid var(--accent);
  border-radius: var(--radius-sm);
}

.intent-text {
  font-size: 24rpx;
  color: var(--accent);
  font-weight: 600;
}

.intent-close {
  margin-left: 12rpx;
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1rpx solid var(--border);
  border-radius: var(--radius-sm);
  background: var(--bg-card);
}

.intent-close-text {
  font-size: 24rpx;
  color: var(--text-hint);
}

/* 输入区 */
.input-bar {
  display: flex;
  align-items: center;
  padding: 16rpx 28rpx;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid var(--border);
  flex-shrink: 0;
}

.input-field {
  flex: 1;
  background: var(--bg-input);
  border: 1rpx solid var(--border);
  border-radius: var(--radius-sm);
  padding: 18rpx 24rpx;
  font-size: 28rpx;
  color: var(--text-primary);
}

.send-btn {
  margin-left: 12rpx;
  padding: 18rpx 28rpx;
  border-radius: var(--radius-sm);
  background: var(--bg-card);
  border: 1rpx solid var(--border);
  transition: all 0.15s;
}

.send-active {
  background: var(--accent-dim);
  border-color: var(--accent);
}

.send-text {
  font-size: 26rpx;
  color: var(--text-secondary);
  font-weight: 600;
  letter-spacing: 1rpx;
}
