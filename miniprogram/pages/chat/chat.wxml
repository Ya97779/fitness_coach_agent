<view class="page">
  <floating-timer />
  <!-- 快捷入口 -->
  <scroll-view class="shortcuts-bar" scroll-x enable-flex>
    <view class="chip" wx:for="{{shortcuts}}" wx:key="text" bindtap="useShortcut" data-text="{{item.text}}">
      <text class="chip-text">{{item.text}}</text>
    </view>
  </scroll-view>

  <!-- 消息列表 -->
  <scroll-view class="msg-list" scroll-y scroll-into-view="{{scrollToId}}" scroll-with-animation enhanced show-scrollbar="{{false}}">
    <view class="msg-item {{item.role}}" wx:for="{{messages}}" wx:key="id" id="msg-{{item.id}}">
      <image class="msg-avatar-img" wx:if="{{item.role === 'user' && userAvatar}}" src="{{userAvatar}}" mode="aspectFill" />
      <view class="msg-avatar" wx:elif="{{item.role === 'user'}}">我</view>
      <view class="msg-avatar" wx:else>AI</view>
      <view class="msg-body">
        <view class="msg-bubble bubble-{{item.role}}">
          <mp-html wx:if="{{item.role !== 'user' && item._visible !== false}}" id="mp-{{item.id}}" content="{{item.html}}" selectable />
          <text wx:else class="msg-text" user-select>{{item.content}}</text>
          <view class="msg-loading" wx:if="{{item.loading}}">
            <view class="loading-dot"></view>
            <view class="loading-dot"></view>
            <view class="loading-dot"></view>
          </view>
        </view>
        <text class="msg-time" wx:if="{{item.role === 'user' && item.timeStr}}">{{item.timeStr}}</text>
      </view>
    </view>
    <view id="msg-bottom" style="height: 20rpx;"></view>
  </scroll-view>

  <!-- 意图记录按钮 -->
  <view class="intent-bar" wx:if="{{pendingIntent}}">
    <view class="intent-btn" bindtap="recordFromIntent">
      <text class="intent-text">{{intentButtonText}}</text>
    </view>
    <view class="intent-close" bindtap="clearIntent">
      <text class="intent-close-text">✕</text>
    </view>
  </view>

  <!-- 输入区 -->
  <view class="input-bar">
    <input class="input-field" placeholder="问我任何健身或营养问题..." value="{{inputValue}}" bindinput="onInput" bindconfirm="sendMessage" confirm-type="send" />
    <view class="send-btn {{inputValue ? 'send-active' : ''}}" bindtap="sendMessage">
      <text class="send-text">发送</text>
    </view>
  </view>
</view>
