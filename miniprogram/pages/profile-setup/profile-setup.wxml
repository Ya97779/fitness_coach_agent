<view class="page">
  <text class="title">设置昵称</text>
  <text class="desc">让 AI 助手更好地认识你</text>

  <!-- 昵称 -->
  <view class="nickname-section">
    <text class="field-label">昵称</text>
    <input class="nickname-input" type="nickname" placeholder="请输入昵称" value="{{nickname}}" bindinput="onNicknameInput" />
  </view>

  <!-- 按钮 -->
  <view class="btn-group">
    <view class="save-btn" bindtap="saveProfile">
      <text class="save-text">保存并开始</text>
    </view>
    <view class="skip-btn" bindtap="skip">
      <text class="skip-text">稍后设置</text>
    </view>
  </view>
</view>
