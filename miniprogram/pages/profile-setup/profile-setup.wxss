.page {
  padding: 80rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.title {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--text-primary);
  display: block;
  margin-bottom: 12rpx;
}

.desc {
  font-size: 26rpx;
  color: var(--text-hint);
  display: block;
  margin-bottom: 60rpx;
}

.nickname-section {
  width: 100%;
  margin-bottom: 60rpx;
}

.field-label {
  font-size: 24rpx;
  color: var(--text-hint);
  font-weight: 600;
  letter-spacing: 2rpx;
  display: block;
  margin-bottom: 12rpx;
}

.nickname-input {
  width: 100%;
  padding: 24rpx;
  background: var(--bg-card);
  border: 1rpx solid var(--border);
  border-radius: var(--radius-md);
  font-size: 30rpx;
  color: var(--text-primary);
  box-sizing: border-box;
}

.btn-group {
  width: 100%;
}

.save-btn {
  width: 100%;
  background: var(--text-primary);
  border-radius: var(--radius-sm);
  padding: 26rpx;
  text-align: center;
  margin-bottom: 24rpx;
}

.save-text {
  font-size: 30rpx;
  font-weight: 700;
  color: #ffffff;
  letter-spacing: 2rpx;
}

.skip-btn {
  width: 100%;
  text-align: center;
  padding: 20rpx;
}

.skip-text {
  font-size: 26rpx;
  color: var(--text-hint);
}
