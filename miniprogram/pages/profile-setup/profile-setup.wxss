.page {
  display: flex;
  flex-direction: column;
  align-items: center;
  min-height: 100vh;
  padding: 80rpx 0 0;
  box-sizing: border-box;
}

.title {
  font-size: 44rpx;
  font-weight: 700;
  color: var(--text-primary);
  margin-bottom: 16rpx;
}

.desc {
  font-size: 28rpx;
  color: var(--text-hint);
  margin-bottom: 80rpx;
}

.nickname-section {
  width: 100%;
  padding: 0 48rpx;
  box-sizing: border-box;
}

.field-label {
  font-size: 26rpx;
  color: var(--text-hint);
  font-weight: 600;
  letter-spacing: 2rpx;
  margin-bottom: 16rpx;
}

.nickname-input {
  width: 100%;
  height: 96rpx;
  line-height: 96rpx;
  padding: 0 28rpx;
  background: var(--bg-card);
  border: 1rpx solid var(--border);
  border-radius: var(--radius-md);
  font-size: 34rpx;
  color: var(--text-primary);
  box-sizing: border-box;
}

.btn-group {
  width: 100%;
  padding: 80rpx 48rpx 0;
  box-sizing: border-box;
}

.save-btn {
  width: 100%;
  height: 96rpx;
  line-height: 96rpx;
  background: var(--text-primary);
  border-radius: var(--radius-sm);
  text-align: center;
  margin-bottom: 28rpx;
}

.save-text {
  font-size: 32rpx;
  font-weight: 700;
  color: #ffffff;
  letter-spacing: 2rpx;
}

.skip-btn {
  width: 100%;
  text-align: center;
  padding: 20rpx 0;
}

.skip-text {
  font-size: 28rpx;
  color: var(--text-hint);
}
