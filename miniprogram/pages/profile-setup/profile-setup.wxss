.page {
  padding: 0 40rpx;
  display: flex;
  flex-direction: column;
  min-height: 100vh;
  box-sizing: border-box;
}

.top-section {
  flex: 1;
  padding-top: 80rpx;
}

.title {
  font-size: 44rpx;
  font-weight: 700;
  color: var(--text-primary);
  display: block;
  margin-bottom: 16rpx;
  text-align: center;
}

.desc {
  font-size: 28rpx;
  color: var(--text-hint);
  display: block;
  margin-bottom: 80rpx;
  text-align: center;
}

.nickname-section {
  width: 100%;
}

.field-label {
  font-size: 26rpx;
  color: var(--text-hint);
  font-weight: 600;
  letter-spacing: 2rpx;
  display: block;
  margin-bottom: 16rpx;
}

.nickname-input {
  width: 100%;
  padding: 28rpx 24rpx;
  background: var(--bg-card);
  border: 1rpx solid var(--border);
  border-radius: var(--radius-md);
  font-size: 32rpx;
  color: var(--text-primary);
  box-sizing: border-box;
  line-height: 1.5;
}

.btn-group {
  width: 100%;
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
}

.save-btn {
  width: 100%;
  background: var(--text-primary);
  border-radius: var(--radius-sm);
  padding: 28rpx;
  text-align: center;
  margin-bottom: 24rpx;
}

.save-text {
  font-size: 32rpx;
  font-weight: 700;
  color: #ffffff;
  letter-spacing: 2rpx;
}

.skip-btn {
  width: 100%;
  text-align: center;
  padding: 20rpx;
}

.skip-text {
  font-size: 28rpx;
  color: var(--text-hint);
}
