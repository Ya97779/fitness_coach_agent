.page {
  min-height: 100vh;
  padding: 32rpx 48rpx;
  box-sizing: border-box;
  background: var(--bg-page, #f5f5f5);
}

.section {
  margin-bottom: 40rpx;
}

.label {
  display: block;
  font-size: 26rpx;
  color: var(--text-hint, #999);
  font-weight: 600;
  letter-spacing: 2rpx;
  margin-bottom: 16rpx;
}

.textarea {
  width: 100%;
  height: 280rpx;
  padding: 24rpx 28rpx;
  background: var(--bg-card, #fff);
  border: 1rpx solid var(--border, #e8e8e8);
  border-radius: var(--radius-md, 12rpx);
  font-size: 30rpx;
  color: var(--text-primary, #1a1a1a);
  box-sizing: border-box;
  line-height: 1.6;
}

.char-count {
  display: block;
  text-align: right;
  font-size: 24rpx;
  color: var(--text-hint, #999);
  margin-top: 8rpx;
}

.input {
  width: 100%;
  height: 96rpx;
  line-height: 96rpx;
  padding: 0 28rpx;
  background: var(--bg-card, #fff);
  border: 1rpx solid var(--border, #e8e8e8);
  border-radius: var(--radius-md, 12rpx);
  font-size: 30rpx;
  color: var(--text-primary, #1a1a1a);
  box-sizing: border-box;
}

.btn-group {
  margin-top: 60rpx;
}

.submit-btn {
  width: 100%;
  height: 96rpx;
  line-height: 96rpx;
  background: var(--text-primary, #1a1a1a);
  border-radius: var(--radius-sm, 8rpx);
  text-align: center;
}

.submit-btn.disabled {
  opacity: 0.4;
}

.submit-text {
  font-size: 32rpx;
  font-weight: 700;
  color: #ffffff;
  letter-spacing: 2rpx;
}
