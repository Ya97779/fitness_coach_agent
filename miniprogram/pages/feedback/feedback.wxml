<view class="page">
  <floating-timer />
  <view class="section">
    <text class="label">你的反馈</text>
    <textarea
      class="textarea"
      placeholder="请描述你的问题或建议"
      maxlength="500"
      value="{{content}}"
      bindinput="onContentInput"
    />
    <text class="char-count">{{content.length}}/500</text>
  </view>

  <view class="section">
    <text class="label">联系方式（可选）</text>
    <input
      class="input"
      placeholder="手机号或微信号，方便我们联系你"
      value="{{contact}}"
      bindinput="onContactInput"
    />
  </view>

  <view class="btn-group">
    <view class="submit-btn {{content.length === 0 ? 'disabled' : ''}}" bindtap="submit">
      <text class="submit-text">提交反馈</text>
    </view>
  </view>
</view>
