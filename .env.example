# 配置选择、模型、路径和功能开关统一维护在 config.yaml。
# 本文件只放密钥和可能包含密码的连接信息，不要写入真实密钥。

# ===== LLM secret =====
OPENAI_API_KEY=your_zhipu_api_key_here

# ===== 数据库连接（可能包含密码） =====
DATABASE_URL=postgresql://user:password@localhost:5432/fitcoach

# ===== 外部服务 secret =====
TianxingFood_API_KEY=your_food_api_key_here
WECHAT_APPID=wx_your_appid_here
WECHAT_SECRET=your_wechat_secret_here
JWT_SECRET_KEY=replace_with_a_random_secret_of_at_least_32_characters
JINA_API_KEY=your_jina_api_key_here
